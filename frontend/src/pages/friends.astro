---
import "../styles/global.css";
import Nav from "../components/Nav";
import ClientRouter from "astro/components/ClientRouter.astro";

const isLoggedIn = !!Astro.locals.user;

// Get friends (people this user follows)
// friendship.friend_id → auth.users; profile.id → auth.users (no direct FK between them)
// so we do two queries rather than a PostgREST embedded join that silently returns nothing
const { data: friendshipRows } = isLoggedIn ? await Astro.locals.supabase
  .from("friendship")
  .select("friend_id")
  .eq("user_id", Astro.locals.user!.id) : { data: null };

const friendIds = (friendshipRows ?? []).map((f: any) => f.friend_id as string);

let friends: any[] = [];
if (friendIds.length > 0) {
  const { data: profileRows } = await Astro.locals.supabase
    .from("profile")
    .select("id, username, display_name, avatar_url")
    .in("id", friendIds);
  friends = profileRows ?? [];
}

let activityFeed: any[] = [];
if (friendIds.length > 0) {
  const { data: activity } = await Astro.locals.supabase
    .from("watchlist")
    .select("user_id, status, added_at, show:show_id(title, date, time, type, url, venue:venue_id(name))")
    .in("user_id", friendIds)
    .order("added_at", { ascending: false })
    .limit(50);
  // attach profile to each activity entry
  const profileMap = Object.fromEntries(friends.map((p: any) => [p.id, p]));
  activityFeed = (activity ?? []).map((e: any) => ({ ...e, profile: profileMap[e.user_id] }));
}

function timeAgo(dateStr: string): string {
  const diff = Date.now() - new Date(dateStr).getTime();
  const days = Math.floor(diff / 86400000);
  if (days === 0) return "today";
  if (days === 1) return "yesterday";
  if (days < 7) return `${days}d ago`;
  if (days < 30) return `${Math.floor(days / 7)}w ago`;
  return `${Math.floor(days / 30)}mo ago`;
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <ClientRouter />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Friends — house lights</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#f5f3ef] min-h-screen">
    <Nav current="/friends" client:load transition:persist />
    <main class="max-w-xl mx-auto px-4 md:px-8 pt-16 md:pt-20 pb-24">

      {!isLoggedIn && (
        <div class="flex flex-col items-center justify-center h-64 gap-4 text-center">
          <p class="text-sm text-[#888]">Sign up to follow friends and see their watchlist activity.</p>
          <div class="flex items-center gap-3">
            <a href="/login?mode=signup" class="text-xs uppercase tracking-widest font-bold text-white bg-[#1a1a1a] border border-[#1a1a1a] px-4 py-2 hover:bg-[#333] transition-colors">
              Sign up
            </a>
            <a href="/login" class="text-xs uppercase tracking-widest text-[#888] hover:text-[#1a1a1a] transition-colors">
              Log in
            </a>
          </div>
        </div>
      )}

      {isLoggedIn && <div>
      <div class="flex items-center justify-between mb-8">
        <h1 class="font-sans font-black text-xl uppercase tracking-tight text-[#1a1a1a]">Friends</h1>
        <div class="flex items-center gap-4">
          <input
            id="search-input"
            type="search"
            placeholder="Find people…"
            class="border border-[#ece7de] bg-white px-3 py-2 text-xs text-[#1a1a1a] placeholder-[#bbb] focus:outline-none focus:border-[#1a1a1a] transition-colors w-44"
          />
        </div>
      </div>

      <div id="search-results" class="hidden mb-8">
        <div class="text-[10px] uppercase tracking-widest text-[#aaa] mb-3">Results</div>
        <ul id="search-list" class="space-y-3"></ul>
      </div>

      {friends.length > 0 && (
        <section class="mb-12">
          <div class="text-[10px] uppercase tracking-widest text-[#aaa] mb-3">Following</div>
          <div class="flex flex-wrap gap-3">
            {friends.map((f: any) => {
              const initials = (f.display_name ?? f.username ?? "?").slice(0, 2).toUpperCase();
              return (
                <a href={`/u/${f.username}`} class="flex items-center gap-2 border border-[#ece7de] bg-white px-3 py-2 hover:border-[#1a1a1a] transition-colors">
                  <div class="w-6 h-6 rounded-full overflow-hidden bg-[#f0ede8] flex items-center justify-center flex-shrink-0">
                    {f.avatar_url
                      ? <img src={f.avatar_url} alt={f.username} class="w-full h-full object-cover" />
                      : <span class="text-[9px] font-bold text-[#888]">{initials}</span>
                    }
                  </div>
                  <div>
                    <div class="text-xs text-[#1a1a1a]">{f.display_name ?? f.username}</div>
                    {f.display_name && <div class="text-[10px] text-[#aaa]">@{f.username}</div>}
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )}

      <section>
        <div class="text-[10px] uppercase tracking-widest text-[#aaa] mb-3">Activity</div>
        {activityFeed.length === 0 ? (
          <p class="text-xs text-[#aaa]">
            {friends.length === 0
              ? "Follow people to see their watchlist activity here."
              : "No recent activity from the people you follow."
            }
          </p>
        ) : (
          <ul class="space-y-4">
            {activityFeed.map((entry: any) => {
              const profile = entry.profile;
              const show = entry.show;
              if (!profile || !show) return null;
              const initials = (profile.display_name ?? profile.username ?? "?").slice(0, 2).toUpperCase();
              const date = show.date ? new Date(show.date).toLocaleDateString("en-NL", { day: "numeric", month: "short" }) : null;
              return (
                <li class="flex gap-3 border-b border-[#ece7de] pb-4 last:border-0">
                  <a href={`/u/${profile.username}`} class="flex-shrink-0 mt-0.5">
                    <div class="w-7 h-7 rounded-full overflow-hidden bg-[#f0ede8] flex items-center justify-center">
                      {profile.avatar_url
                        ? <img src={profile.avatar_url} alt={profile.username} class="w-full h-full object-cover" />
                        : <span class="text-[9px] font-bold text-[#888]">{initials}</span>
                      }
                    </div>
                  </a>
                  <div class="min-w-0 flex-1">
                    <p class="text-xs text-[#555] leading-relaxed">
                      <a href={`/u/${profile.username}`} class="font-medium text-[#1a1a1a] hover:underline">
                        {profile.display_name ?? profile.username}
                      </a>
                      {" "}
                      {entry.status === "tickets_bought" ? "bought tickets for" : "is watching"}
                      {" "}
                      {show.url
                        ? <a href={show.url} target="_blank" rel="noopener noreferrer" class="font-medium text-[#1a1a1a] hover:underline">{show.title}</a>
                        : <span class="font-medium text-[#1a1a1a]">{show.title}</span>
                      }
                    </p>
                    <p class="text-[10px] text-[#bbb] mt-0.5">
                      {show.venue?.name}
                      {date && <span class="ml-2">{date}</span>}
                      <span class="ml-2">{timeAgo(entry.added_at)}</span>
                    </p>
                  </div>
                </li>
              );
            })}
          </ul>
        )}
      </section>
      </div>}

      <script>
        const searchInput = document.getElementById("search-input") as HTMLInputElement;
        const searchResults = document.getElementById("search-results") as HTMLDivElement;
        const searchList = document.getElementById("search-list") as HTMLUListElement;
        let debounce: ReturnType<typeof setTimeout>;

        searchInput?.addEventListener("input", () => {
          clearTimeout(debounce);
          const q = searchInput.value.trim();
          if (q.length < 2) { searchResults.classList.add("hidden"); return; }
          debounce = setTimeout(async () => {
            const res = await fetch(`/api/users/search?q=${encodeURIComponent(q)}`);
            const users: any[] = await res.json();
            searchList.innerHTML = "";
            if (users.length === 0) {
              searchList.innerHTML = '<li class="text-xs text-[#aaa]">No results.</li>';
            } else {
              for (const u of users) {
                const initials = ((u.display_name ?? u.username) as string).slice(0, 2).toUpperCase();
                const li = document.createElement("li");
                li.innerHTML = `
                  <a href="/u/${u.username}" class="flex items-center gap-3 border border-[#ece7de] bg-white px-3 py-2 hover:border-[#1a1a1a] transition-colors">
                    <div class="w-7 h-7 rounded-full overflow-hidden bg-[#f0ede8] flex items-center justify-center flex-shrink-0">
                      ${u.avatar_url
                        ? `<img src="${u.avatar_url}" alt="${u.username}" class="w-full h-full object-cover" />`
                        : `<span class="text-[9px] font-bold text-[#888]">${initials}</span>`
                      }
                    </div>
                    <div>
                      <div class="text-xs font-medium text-[#1a1a1a]">${u.display_name ?? u.username}</div>
                      ${u.display_name ? `<div class="text-[10px] text-[#aaa]">@${u.username}</div>` : ""}
                    </div>
                  </a>`;
                searchList.appendChild(li);
              }
            }
            searchResults.classList.remove("hidden");
          }, 300);
        });

        document.addEventListener("click", (e) => {
          if (!searchInput?.contains(e.target as Node) && !searchResults?.contains(e.target as Node)) {
            searchResults?.classList.add("hidden");
          }
        });
      </script>
    </main>
  </body>
</html>
