---
import "../styles/global.css";
import Nav from "../components/Nav";
import AvatarUpload from "../components/AvatarUpload";
import ClientRouter from "astro/components/ClientRouter.astro";

if (!Astro.locals.user) return Astro.redirect("/login");

const { data: profile } = await Astro.locals.supabase
  .from("profile")
  .select("username, display_name, avatar_url")
  .eq("id", Astro.locals.user.id)
  .single();

const { data: venuesData } = await Astro.locals.supabase
  .from("venue")
  .select("id, name, city_id, city:city_id(name, country)")
  .eq("active", true)
  .order("name");

const venues = venuesData ?? [];

const { data: citiesData } = await Astro.locals.supabase
  .from("city")
  .select("id, name, country, is_active")
  .order("name");

const cities = citiesData ?? [];

const { data: userCitiesData } = await Astro.locals.supabase
  .from("user_city")
  .select("city_id")
  .eq("user_id", Astro.locals.user.id);

const enabledCityIds = new Set((userCitiesData ?? []).map((r: { city_id: string }) => r.city_id));

const { data: hiddenVenueData } = await Astro.locals.supabase
  .from("user_venue")
  .select("venue_id")
  .eq("user_id", Astro.locals.user.id)
  .eq("hidden", true);

const hiddenVenueIds = new Set((hiddenVenueData ?? []).map((r: { venue_id: string }) => r.venue_id));

type VenueItem = { id: string; name: string; city_id: string; city: { name: string; country: string } | null };
type CityItem = { id: string; name: string; country: string; is_active: boolean };

// Group venues by city for display
const venuesByCity = (cities as CityItem[])
  .filter(c => c.is_active)
  .map(c => ({
    city: c,
    venues: (venues as VenueItem[]).filter(v => v.city_id === c.id),
  }))
  .filter(g => g.venues.length > 0);

const updated = Astro.url.searchParams.get("updated");
const error = Astro.url.searchParams.get("error");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <ClientRouter />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Settings — house lights</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#f5f3ef] min-h-screen">
    <Nav current="/settings" client:load transition:persist />
    <main class="max-w-xl mx-auto px-4 md:px-8 pt-16 md:pt-20 pb-24">
      <h1 class="font-sans font-black text-xl uppercase tracking-tight text-[#1a1a1a] mb-8">Settings</h1>

      {updated && <p class="text-xs text-green-700 mb-6">Saved.</p>}
      {error && <p class="text-xs text-[#e85d2f] mb-6">{decodeURIComponent(error)}</p>}

      <!-- Profile -->
      <section class="mb-12">
        <h2 class="font-bold text-xs uppercase tracking-widest text-[#1a1a1a] mb-5">Profile</h2>
        <AvatarUpload
          currentUrl={profile?.avatar_url ?? null}
          username={profile?.username ?? "?"}
          client:load
        />
        <form method="POST" action="/api/profile/update" class="space-y-5">
          <div>
            <label class="block text-xs uppercase tracking-widest text-[#888] mb-2">Username</label>
            <div class="relative">
              <input
                id="settings-username"
                type="text"
                name="username"
                value={profile?.username ?? ""}
                required
                minlength="2"
                maxlength="30"
                pattern="[a-z0-9_-]+"
                title="Lowercase letters, numbers, hyphens and underscores only"
                class="w-full border border-[#ece7de] bg-white px-4 py-3 text-sm text-[#1a1a1a] focus:outline-none focus:border-[#1a1a1a] transition-colors pr-8"
              />
              <span id="settings-username-status" class="absolute right-3 top-1/2 -translate-y-1/2 text-sm font-bold"></span>
            </div>
            <p id="settings-username-hint" class="text-xs text-[#aaa] mt-1">Lowercase letters, numbers, - and _ only</p>
          </div>
          <div>
            <label class="block text-xs uppercase tracking-widest text-[#888] mb-2">Display name</label>
            <input
              type="text"
              name="display_name"
              value={profile?.display_name ?? ""}
              class="w-full border border-[#ece7de] bg-white px-4 py-3 text-sm text-[#1a1a1a] focus:outline-none focus:border-[#1a1a1a] transition-colors"
            />
          </div>
          <button type="submit" class="bg-[#1a1a1a] text-white text-xs py-2 px-6 hover:bg-[#333] transition-colors uppercase tracking-widest font-bold">
            Save profile
          </button>
        </form>
      </section>

      <!-- Cities -->
      <section class="mb-12 border-t border-[#ece7de] pt-10">
        <h2 class="font-bold text-xs uppercase tracking-widest text-[#1a1a1a] mb-2">Cities</h2>
        <p class="text-xs text-[#aaa] mb-6">Choose which cities to include in your browse feed.</p>
        <div class="flex flex-wrap gap-2">
          {cities.map((city: CityItem) => {
            const isEnabled = enabledCityIds.has(city.id);
            if (city.is_active) {
              return (
                <form method="POST" action="/api/user/cities" class="inline">
                  <input type="hidden" name="city_id" value={city.id} />
                  <input type="hidden" name="enabled" value={isEnabled ? "false" : "true"} />
                  <button
                    type="submit"
                    class={`text-xs px-3 py-1.5 border transition-colors ${isEnabled ? "bg-[#1a1a1a] border-[#1a1a1a] text-white" : "border-[#ece7de] text-[#555] hover:border-[#1a1a1a]"}`}
                  >
                    {city.name}
                    {city.country !== "NL" && <span class="ml-1 opacity-50">{city.country}</span>}
                  </button>
                </form>
              );
            } else {
              return (
                <span class="text-xs px-3 py-1.5 border border-dashed border-[#ddd8cf] text-[#bbb] cursor-default" title="Coming soon">
                  {city.name}
                  {city.country !== "NL" && <span class="ml-1 opacity-40">{city.country}</span>}
                </span>
              );
            }
          })}
        </div>
      </section>

      <!-- Venues -->
      <section class="mb-12 border-t border-[#ece7de] pt-10">
        <h2 class="font-bold text-xs uppercase tracking-widest text-[#1a1a1a] mb-2">Venues</h2>
        <p class="text-xs text-[#aaa] mb-6">Hide venues you never want to see in Browse. Hidden venues are greyed out.</p>

        {venuesByCity.map(group => (
          <div class="mb-8">
            {venuesByCity.length > 1 && (
              <div class="text-[10px] uppercase tracking-widest text-[#aaa] mb-3">{group.city.name}</div>
            )}
            <div class="flex flex-wrap gap-2">
              {group.venues.map((item: VenueItem) => {
                const isHidden = hiddenVenueIds.has(item.id);
                return (
                  <form method="POST" action="/api/user/venues" class="inline">
                    <input type="hidden" name="venue_id" value={item.id} />
                    <input type="hidden" name="hidden" value={isHidden ? "false" : "true"} />
                    <button
                      type="submit"
                      class={`text-xs px-3 py-1.5 border transition-colors ${
                        isHidden
                          ? "border-dashed border-[#ddd8cf] text-[#bbb]"
                          : "border-[#ece7de] text-[#555] hover:border-[#1a1a1a] hover:text-[#1a1a1a]"
                      }`}
                    >
                      {item.name}
                    </button>
                  </form>
                );
              })}
            </div>
          </div>
        ))}
      </section>

      <!-- Account -->
      <section class="border-t border-[#ece7de] pt-8 mb-12">
        <h2 class="font-bold text-xs uppercase tracking-widest text-[#1a1a1a] mb-4">Account</h2>
        <p class="text-xs text-[#888] mb-4">Signed in as {Astro.locals.user.email}</p>
        <a href="/api/auth/logout" class="text-xs uppercase tracking-widest text-[#888] hover:text-[#1a1a1a] transition-colors">Sign out</a>
      </section>

      <!-- Data & privacy -->
      <section class="border-t border-[#ece7de] pt-8">
        <h2 class="font-bold text-xs uppercase tracking-widest text-[#1a1a1a] mb-2">Data & privacy</h2>
        <p class="text-xs text-[#aaa] mb-6">Your data belongs to you.</p>
        <div class="flex flex-col gap-3">
          <div>
            <a
              href="/api/account/export"
              class="text-xs uppercase tracking-widest text-[#888] hover:text-[#1a1a1a] transition-colors"
            >
              Download my data
            </a>
            <p class="text-[10px] text-[#bbb] mt-1">Exports your watchlist and profile as JSON.</p>
          </div>
          <div>
            <button
              id="delete-account-btn"
              type="button"
              class="text-xs uppercase tracking-widest text-[#e85d2f] hover:text-[#c44020] transition-colors"
            >
              Delete account
            </button>
            <p class="text-[10px] text-[#bbb] mt-1">Permanently deletes your account and all data.</p>
          </div>
        </div>
      </section>

      <script>
        // Real-time username availability check
        const usernameInput = document.getElementById("settings-username") as HTMLInputElement;
        const usernameStatus = document.getElementById("settings-username-status") as HTMLSpanElement;
        const usernameHint = document.getElementById("settings-username-hint") as HTMLParagraphElement;
        let uDebounce: ReturnType<typeof setTimeout>;
        const originalUsername = usernameInput?.value ?? "";

        usernameInput?.addEventListener("input", () => {
          clearTimeout(uDebounce);
          const val = usernameInput.value.trim().toLowerCase();
          if (!val || val === originalUsername) {
            usernameStatus.textContent = "";
            usernameHint.textContent = "Lowercase letters, numbers, - and _ only";
            usernameHint.className = "text-xs text-[#aaa] mt-1";
            return;
          }
          if (!/^[a-z0-9_-]+$/.test(val) || val.length < 2 || val.length > 30) {
            usernameStatus.textContent = "✗";
            usernameStatus.className = "absolute right-3 top-1/2 -translate-y-1/2 text-sm font-bold text-[#e85d2f]";
            usernameHint.textContent = "2–30 characters: letters, numbers, - and _ only";
            usernameHint.className = "text-xs text-[#e85d2f] mt-1";
            return;
          }
          usernameStatus.textContent = "…";
          usernameStatus.className = "absolute right-3 top-1/2 -translate-y-1/2 text-sm font-bold text-[#aaa]";
          uDebounce = setTimeout(async () => {
            const res = await fetch(`/api/users/check-username?username=${encodeURIComponent(val)}`);
            const { available } = await res.json();
            if (available) {
              usernameStatus.textContent = "✓";
              usernameStatus.className = "absolute right-3 top-1/2 -translate-y-1/2 text-sm font-bold text-green-600";
              usernameHint.textContent = "Lowercase letters, numbers, - and _ only";
              usernameHint.className = "text-xs text-[#aaa] mt-1";
            } else {
              usernameStatus.textContent = "✗";
              usernameStatus.className = "absolute right-3 top-1/2 -translate-y-1/2 text-sm font-bold text-[#e85d2f]";
              usernameHint.textContent = "That username is already taken";
              usernameHint.className = "text-xs text-[#e85d2f] mt-1";
            }
          }, 400);
        });
      </script>

      <script>
        document.getElementById("delete-account-btn")?.addEventListener("click", async () => {
          if (!confirm("Are you sure? This permanently deletes your account and all your data. This cannot be undone.")) return;
          const res = await fetch("/api/account/delete", { method: "POST" });
          if (res.ok) {
            window.location.href = "/login?message=" + encodeURIComponent("Your account has been deleted.");
          } else {
            alert("Something went wrong. Please try again.");
          }
        });
      </script>
    </main>
  </body>
</html>
