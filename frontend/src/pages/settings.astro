---
import "../styles/global.css";
import Nav from "../components/Nav";
import ClientRouter from "astro/components/ClientRouter.astro";

if (!Astro.locals.user) return Astro.redirect("/login");

const { data: profile } = await Astro.locals.supabase
  .from("profile")
  .select("username, display_name")
  .eq("id", Astro.locals.user.id)
  .single();

const { data: venuesData } = await Astro.locals.supabase
  .from("venue")
  .select("id, name, priority")
  .eq("active", true)
  .order("name");

const venues = venuesData ?? [];

const PRIORITY_ORDER = ["high", "medium", "low"];
const PRIORITY_LABEL: Record<string, string> = { high: "Regular", medium: "Occasional", low: "Exploring" };

type Item = { id: string; name: string; priority: string };

const grouped = PRIORITY_ORDER.map(p => ({
  label: PRIORITY_LABEL[p],
  priority: p,
  venues: venues.filter((v: Item) => v.priority === p),
}));

const updated = Astro.url.searchParams.get("updated");
const error = Astro.url.searchParams.get("error");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <ClientRouter />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Settings — house lights</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#f5f3ef] min-h-screen">
    <Nav current="/settings" client:load transition:persist />
    <main class="max-w-xl mx-auto px-4 md:px-8 pt-16 md:pt-20 pb-24">
      <h1 class="font-sans font-black text-xl uppercase tracking-tight text-[#1a1a1a] mb-8">Settings</h1>

      {updated && <p class="text-xs text-green-700 mb-6">Saved.</p>}
      {error && <p class="text-xs text-[#e85d2f] mb-6">{decodeURIComponent(error)}</p>}

      <!-- Profile -->
      <section class="mb-12">
        <h2 class="font-bold text-xs uppercase tracking-widest text-[#1a1a1a] mb-5">Profile</h2>
        <form method="POST" action="/api/profile/update" class="space-y-5">
          <div>
            <label class="block text-xs uppercase tracking-widest text-[#888] mb-2">Username</label>
            <input
              type="text"
              name="username"
              value={profile?.username ?? ""}
              required
              pattern="[a-z0-9_-]+"
              title="Lowercase letters, numbers, hyphens and underscores only"
              class="w-full border border-[#ece7de] bg-white px-4 py-3 text-sm text-[#1a1a1a] focus:outline-none focus:border-[#1a1a1a] transition-colors"
            />
            <p class="text-xs text-[#aaa] mt-1">Lowercase letters, numbers, - and _ only</p>
          </div>
          <div>
            <label class="block text-xs uppercase tracking-widest text-[#888] mb-2">Display name</label>
            <input
              type="text"
              name="display_name"
              value={profile?.display_name ?? ""}
              class="w-full border border-[#ece7de] bg-white px-4 py-3 text-sm text-[#1a1a1a] focus:outline-none focus:border-[#1a1a1a] transition-colors"
            />
          </div>
          <button type="submit" class="bg-[#1a1a1a] text-white text-xs py-2 px-6 hover:bg-[#333] transition-colors uppercase tracking-widest font-bold">
            Save profile
          </button>
        </form>
      </section>

      <!-- Venue rankings -->
      <section class="mb-12 border-t border-[#ece7de] pt-10">
        <h2 class="font-bold text-xs uppercase tracking-widest text-[#1a1a1a] mb-2">Venue rankings</h2>
        <p class="text-xs text-[#aaa] mb-6">Controls how venues are weighted in filters. Regular = shown by default.</p>

        {grouped.map(group => (
          <div class="mb-8">
            <div class="text-[10px] uppercase tracking-widest text-[#aaa] mb-3">{group.label}</div>
            <div class="flex flex-wrap gap-2">
              {group.venues.sort((a: Item, b: Item) => a.name.localeCompare(b.name)).map((item: Item) => (
                <form method="POST" action="/api/venue/priority" class="inline">
                  <input type="hidden" name="id" value={item.id} />
                  <input type="hidden" name="kind" value="venue" />
                  <div class="flex items-center gap-0 border border-[#ece7de] bg-white text-xs text-[#555]">
                    <span class="px-3 py-1.5">{item.name}</span>
                    <select
                      name="priority"
                      onchange="this.form.submit()"
                      class="text-[10px] border-l border-[#ece7de] px-2 py-1.5 bg-white text-[#888] focus:outline-none cursor-pointer"
                    >
                      {PRIORITY_ORDER.map(p => (
                        <option value={p} selected={item.priority === p}>{PRIORITY_LABEL[p]}</option>
                      ))}
                    </select>
                  </div>
                </form>
              ))}
            </div>
          </div>
        ))}
      </section>

      <!-- Account -->
      <section class="border-t border-[#ece7de] pt-8">
        <h2 class="font-bold text-xs uppercase tracking-widest text-[#1a1a1a] mb-4">Account</h2>
        <p class="text-xs text-[#888] mb-4">Signed in as {Astro.locals.user.email}</p>
        <a href="/api/auth/logout" class="text-xs uppercase tracking-widest text-[#888] hover:text-[#1a1a1a] transition-colors">Sign out</a>
      </section>
    </main>
  </body>
</html>
