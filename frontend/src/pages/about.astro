---
import "../styles/global.css";
import Nav from "../components/Nav";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import { readFileSync } from "fs";
import { getIsAdmin } from "../lib/admin";
import { resolve } from "path";

const isAdmin = await getIsAdmin(Astro.locals.supabase, Astro.locals.user?.id);
const raw = readFileSync(resolve("src/content/about.md"), "utf-8");
const paragraphs = raw.split(/\n\n+/).map((p) => p.trim()).filter(Boolean);

const { data: venuesData } = await Astro.locals.supabase
  .from("venue")
  .select("id, name, city_id, website_url, city:city_id(name)")
  .eq("active", true)
  .order("name");

const { data: citiesData } = await Astro.locals.supabase
  .from("city")
  .select("id, name")
  .eq("is_active", true)
  .order("name");

const venues = venuesData ?? [];
const cities = citiesData ?? [];

type VenueItem = { id: string; name: string; city_id: string; website_url?: string | null; city: { name: string } | null };
type CityItem = { id: string; name: string };

const grouped = (cities as CityItem[]).map(c => ({
  city: c,
  items: (venues as VenueItem[]).filter(v => v.city_id === c.id),
})).filter(g => g.items.length > 0);
---

<html lang="en">
  <head>
    <BaseHead title="About — house lights" playfair />
  </head>
  <body class="bg-[#f5f3ef] min-h-screen">
    <Nav current="/about" isAdmin={isAdmin} client:load transition:persist />
    <main class="max-w-2xl mx-auto px-4 md:px-8 pt-16 md:pt-20 pb-24 md:pb-8">

      <div class="text-sm text-[#555] leading-relaxed space-y-4 mb-8">
        {paragraphs.map((p: string) => {
          if (p.startsWith("- ")) {
            const items = p.split("\n").filter((l: string) => l.startsWith("- "));
            return (
              <ul class="space-y-2 pl-0">
                {items.map((item: string) => {
                  const content = item.slice(2);
                  const formatted = content.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
                  return <li class="flex gap-2"><span class="text-[#e85d2f]">—</span><span set:html={formatted} /></li>;
                })}
              </ul>
            );
          }
          return <p>{p}</p>;
        })}
      </div>

      <div class="mb-16">
        <a
          href="https://ko-fi.com/claireheaded"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block text-xs text-[#888] border border-[#ece7de] px-4 py-2 hover:border-[#1a1a1a] hover:text-[#1a1a1a] transition-colors"
        >
          ☕ Support on Ko-fi
        </a>
      </div>

      <section class="mb-16">
        <h2 class="font-sans font-black text-xs uppercase tracking-widest text-[#1a1a1a] mb-6">Venues tracked</h2>
        {grouped.map(group => (
          <div class="mb-6">
            {grouped.length > 1 && (
              <div class="text-[10px] uppercase tracking-widest text-[#aaa] mb-2">{group.city.name}</div>
            )}
            <div class="flex flex-wrap gap-2">
              {group.items.map((item: VenueItem) => (
                item.website_url
                  ? <a href={item.website_url} target="_blank" rel="noopener noreferrer"
                      class="text-xs border border-[#ece7de] px-3 py-1 text-[#555] hover:border-[#1a1a1a] hover:text-[#1a1a1a] transition-colors">
                      {item.name}
                    </a>
                  : <span class="text-xs border border-[#ece7de] px-3 py-1 text-[#555]">{item.name}</span>
              ))}
            </div>
          </div>
        ))}
        {Astro.locals.user && (
          <p class="text-xs text-[#aaa] mt-4">
            Hide venues you never want to see in <a href="/settings" class="underline hover:text-[#555]">Settings</a>.
          </p>
        )}
      </section>

      <Footer />

    </main>
  </body>
</html>
